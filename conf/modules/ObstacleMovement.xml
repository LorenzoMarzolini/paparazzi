<!DOCTYPE module SYSTEM "module.dtd">

<module name="Obstacle_Movement" dir="ObstacleMovement">
  <doc>
    <description>
      Obstacle Avoidance Movement Module.
      This module receives obstacle detection commands via ABI and adjusts the drone's guidance
      (velocity and heading rate) accordingly. The decision is made based on which side has more free space.
    </description>
  </doc>
  
  <!-- Optional dynamic settings for movement parameters -->
  <settings>
    <dl_settings>
      <dl_settings name="Obstacle_Movement">
         <dl_setting var="oag_max_speed" min="0" step="0.1" max="5" unit="m/s" description="Maximum forward speed"/>
         <dl_setting var="oag_heading_rate" min="0" step="5" max="45" unit="deg" description="Heading rate for avoidance"/>
      </dl_settings>
    </dl_settings>
  </settings>
  
  <header>
    <file name="ObstacleMovement.h"/>
  </header>
  
  <init fun="obstacle_move_init()"/>
  <periodic fun="obstacle_move_periodic()" freq="40"/>
  
  <makefile target="ap|nps">
    <file name="ObstacleMovement.c"/>
  </makefile>
</module>
