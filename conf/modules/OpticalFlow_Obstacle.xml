<!DOCTYPE module SYSTEM "module.dtd">

<module name="OpticalFlow_Obstacle" dir="OpticalFlow_Obstacle">
  <doc>
    <description>
      Optical Flow Obstacle Detection Module.
      This module computes a simplified optical flow from consecutive camera frames
      to detect obstacles based on flow magnitudes. It then sends an ABI command based
      on which side (left or right) is more obstructed.
    </description>
    <!-- Define the camera to use. Ensure that FLOOR_DET_CAMERA is defined globally if needed -->
    <define name="FLOOR_DET_CAMERA" value="front_camera|bottom_camera" description="Video device to use"/>
    <define name="FLOOR_DETECTOR_FPS" value="0" description="Desired FPS (0: camera rate)"/>
    <define name="COLOR_OBJECT_DETECTOR_LUM_MIN1" value="0" description="Filter 1 min luminance"/>
    <define name="COLOR_OBJECT_DETECTOR_LUM_MAX1" value="0" description="Filter 1 max luminance"/>
    <define name="COLOR_OBJECT_DETECTOR_CB_MIN1" value="0" description="Filter 1 min blue chroma"/>
    <define name="COLOR_OBJECT_DETECTOR_CB_MAX1" value="0" description="Filter 1 max blue chroma"/>
    <define name="COLOR_OBJECT_DETECTOR_CR_MIN1" value="0" description="Filter 1 min red chroma"/>
    <define name="COLOR_OBJECT_DETECTOR_CR_MAX1" value="0" description="Filter 1 max red chroma"/>
    <define name="COLOR_OBJECT_DETECTOR_DRAW1" value="FALSE|TRUE" description="Whether or not to draw on image"/>
  </doc>

  <dep>
    <depends>video_thread</depends>
  </dep>
  
  <header>
    <file name="OpticalFlow_Obstacle.h"/>
  </header>
  
  <init fun="optical_flow_obs_init()"/>
  <!-- Periodic function is provided (even if empty) for potential future use -->
  <periodic fun="optical_flow_obs_periodic()" freq="40"/>
  
  <makefile target="ap|nps">
    <file name="OpticalFlow_Obstacle.c"/>
  </makefile>
</module>
