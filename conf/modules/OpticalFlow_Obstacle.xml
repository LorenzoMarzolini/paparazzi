<!DOCTYPE module SYSTEM "module.dtd">

<module name="OpticalFlow_Obstacle" dir="OpticalFlow_Obstacle">
  <doc>
    <description>
      Optical Flow Obstacle Detection Module.
      This module computes a simplified optical flow from consecutive camera frames
      to detect obstacles based on flow magnitudes. It then sends an ABI command based
      on which side (left or right) is more obstructed.
    </description>
    <!-- Define the camera to use. Ensure that FLOOR_DET_CAMERA is defined globally if needed -->
    <define name="TCT_CAMERA_DETECTION_ID" value="ABI_BROADCAST" description="which VISUAL_DETECTION message to recieve for orange pole detection."/>
  </doc>
  
  <!-- Optional settings if you wish to adjust parameters; currently none are exposed -->
  <settings>
    <dl_settings>
      <dl_settings name="OpticalFlow_Obstacle">
        <dl_setting var="oag_max_speed" min="0" step="0.1" max="5" unit="m/s"/>
        <dl_setting var="oag_heading_rate" min="0" step="5" max="45" unit="deg"/>
      </dl_settings>
    </dl_settings>
  </settings>
  
  <header>
    <file name="OpticalFlow_Obstacle.h"/>
  </header>
  
  <init fun="optical_flow_obs_init()"/>
  <!-- Periodic function is provided (even if empty) for potential future use -->
  <periodic fun="optical_flow_obs_periodic()" freq="50"/>
  
  <makefile target="ap|nps">
    <file name="OpticalFlow_Obstacle.c"/>
  </makefile>
</module>
