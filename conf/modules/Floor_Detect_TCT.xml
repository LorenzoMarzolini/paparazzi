      </dl_settings>
    </dl_settings>
  </settings>
  <header>
    <file name="Floor_Detect.h"/>
  </header>
  <init fun="floor_detect_init()"/>
  <periodic fun="floor_detect_periodic()" freq="40"/>
  <makefile target="ap|nps">
    <file name="Floor_Detect.c"/>
  </makefile>
</module>