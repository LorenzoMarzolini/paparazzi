<!DOCTYPE module SYSTEM "module.dtd">

<module name="Floor_Detect_TCT" dir="Floor_Detection_TCT">
  <doc>
    <description>
    desc
    </description>
    <define name="TCT_CAMERA_DETECTION_ID" value="ABI_BROADCAST" description="which VISUAL_DETECTION message to recieve for orange pole detection."/>
  </doc>
  <settings>
    <dl_settings>
      <dl_settings name="Floor_Detection_TCT">
